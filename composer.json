{
	"name": "celema/quma",
	"description": "A no-ORM database library for executing raw SQL files",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celema.dev"
		}
	],
	"homepage": "https://celema.dev/quma",
	"keywords": [
		"celema",
		"database",
		"sql"
	],
	"autoload": {
		"psr-4": {
			"Celema\\Quma\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Celema\\Quma\\Tests\\": "tests"
		}
	},
	"require": {
		"php": "^8.5",
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-readline": "*",
		"celema/console": "^0.5"
	},
	"require-dev": {
		"carthage-software/mago": "~1.47.0",
		"celema/dev": "^6.0",
		"ernst/coverlyzer": "^0.3",
		"phpunit/phpunit": "^13.0",
		"vimeo/psalm": "~6.16.0"
	},
	"scripts": {
		"test:base": "@php vendor/bin/phpunit --testdox --no-coverage --colors=always",
		"test:sqlite": "QUMA_TEST_DRIVERS=sqlite composer test:base",
		"test:mysql": "QUMA_TEST_DRIVERS=mysql composer test:base",
		"test:pgsql": "QUMA_TEST_DRIVERS=pgsql composer test:base",
		"test:all": "QUMA_TEST_DRIVERS=sqlite,mysql,pgsql composer test:base",
		"test": "composer test:base",
		"coverage:test": "QUMA_TEST_DRIVERS=sqlite,mysql,pgsql php -d xdebug.mode=coverage vendor/bin/phpunit --testdox --path-coverage --colors=always",
		"coverage:analyze": "@php vendor/bin/coverlyzer .coverage/coverage.php",
		"coverage": [
			"composer coverage:test",
			"composer coverage:analyze"
		],
		"types": "@php vendor/bin/psalm --no-cache",
		"lint": [
			"@php vendor/bin/mago fmt --check",
			"@php vendor/bin/mago lint"
		],
		"docs:format": "npx prettier@3.6.2 --write --config docs/.prettierrc README.md CHANGELOG.md LICENSE.md docs/",
		"docs:lint": "npx markdownlint-cli2@0.22.1 --config vendor/celema/dev/config/markdownlint.jsonc README.md CHANGELOG.md LICENSE.md docs/",
		"ci": [
			"composer lint",
			"composer coverage",
			"composer types"
		],
		"ci:full": [
			"composer ci",
			"composer docs:lint"
		]
	}
}
